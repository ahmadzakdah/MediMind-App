<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- طبقة ظل خفيفة (Glow) -->
    <item>
        <shape>
            <corners android:radius="22dp"/>
            <solid android:color="#2200E5FF"/> <!-- سيان خفيف جدًا -->
        </shape>
    </item>

    <!-- الطبقة الأساسية -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="20dp"/>
            <solid android:color="#12FFFFFF"/> <!-- زجاجي خفيف -->
            <stroke android:width="1dp" android:color="#55FFFFFF"/>
        </shape>
    </item>

</layer-list>
