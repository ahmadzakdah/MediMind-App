<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D008F">

    <!-- ✅ ثابت: نهاية المنطقة البنفسجية -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelinePurpleEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="140dp" />

    <!-- الهيدر الثابت في كل الشاشات -->
    <include
        android:id="@+id/incHeader"
        layout="@layout/include_header_medimind"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ✅ Bottom Nav (زي ما هو) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#F6F1FF"
        app:strokeWidth="1dp"
        app:strokeColor="#333D008F"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/indicatorHome"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="#3D008F"
                    android:visibility="visible"/>

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_home"
                    app:tint="#3D008F" />

                <TextView
                    android:id="@+id/textHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#3D008F"/>
            </LinearLayout>

            <!-- Patients -->
            <LinearLayout
                android:id="@+id/navPatients"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/indicatorPatients"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="#3D008F"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/iconPatients"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_patients"
                    app:tint="#999999" />

                <TextView
                    android:id="@+id/textPatients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patients"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#999999"/>
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/indicatorProfile"
                    android:layout_width="26dp"
                    android:layout_height="4dp"
                    android:background="#3D008F"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/iconProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_user"
                    app:tint="#999999" />

                <TextView
                    android:id="@+id/textProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#999999"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ✅ الكارد الأبيض الكبير: يبدأ من نهاية البنفسجي وينتهي فوق bottomCard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/whitePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_white_panel_top"
        app:layout_constraintTop_toTopOf="@id/guidelinePurpleEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ✅ محتوى الصفحات جوّا الأبيض -->
        <FrameLayout
            android:id="@+id/baseContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="110dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ✅ العنوان ملاصق للأبيض (مش مربوط بالهيدر) -->
    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:text="Home"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/whitePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
