<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4B0099">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#EDEAF5"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Consultation"
                    android:textColor="#4B0099"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- ======= VITALS ======= -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vitals"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etSysBP"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/search_box_bg"
                        android:hint="Systolic BP (mmHg)"
                        android:inputType="number"
                        android:padding="12dp"
                        android:maxLength="3" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <EditText
                        android:id="@+id/etDiaBP"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/search_box_bg"
                        android:hint="Diastolic BP (mmHg)"
                        android:inputType="number"
                        android:padding="12dp"
                        android:maxLength="3" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etHR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_box_bg"
                    android:hint="Heart Rate (bpm)"
                    android:inputType="number"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etRR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_box_bg"
                    android:hint="Respiratory Rate (breaths/min)"
                    android:inputType="number"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etBloodSugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_box_bg"
                    android:hint="Blood Sugar (mg/dL)"
                    android:inputType="number"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_box_bg"
                    android:hint="Temperature (°C)"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etSpO2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/search_box_bg"
                    android:hint="SpO₂ (%)"
                    android:inputType="number"
                    android:padding="12dp" />

                <!-- ======= SYMPTOMS ======= -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Symptoms"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <AutoCompleteTextView
                    android:id="@+id/etSymptom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/search_box_bg"
                    android:hint="Type a symptom (e.g., fever)"
                    android:inputType="text"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnAddSymptom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Add Symptom"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4B0099" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsSymptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacing="8dp"
                    app:singleLine="false"
                    app:singleSelection="false" />

                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/search_box_bg"
                    android:gravity="top"
                    android:hint="Notes (optional)"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnSaveConsultation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Save Consultation"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#00BFA6" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
