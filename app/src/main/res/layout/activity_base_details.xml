<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBaseDetails"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D008F">

    <!-- ✅ ثابت: نهاية المنطقة البنفسجية -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelinePurpleEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="140dp" />

    <!-- ✅ الهيدر البنفسجي (ارتفاعه ثابت لأنه مربوط بالـ guideline) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#3D008F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guidelinePurpleEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ✅ نفس الهيدر الموحد -->
        <include
            android:id="@+id/incHeader"
            layout="@layout/include_header_medimind"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ✅ الكارد الأبيض يبدأ من نفس مكان نهاية البنفسجي -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/whitePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_white_panel_top"
        app:layout_constraintTop_toTopOf="@id/guidelinePurpleEnd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ✅ الكونتينر جوّا الكارد الأبيض -->
        <FrameLayout
            android:id="@+id/detailsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ✅ عنوان الشاشة: فوق الكارد الأبيض مباشرة (شبه ملاصق) -->
    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="6dp"
        android:text="Title"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/whitePanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
