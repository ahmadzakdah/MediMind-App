<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPatientItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#F9F9F9"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/imgPatient"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_patients"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Archive button -->
        <ImageView
            android:id="@+id/btnArchive"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_archive"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Archive"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Name -->
        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Patient Name"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/imgPatient"
            app:layout_constraintStart_toEndOf="@id/imgPatient"
            app:layout_constraintEnd_toStartOf="@id/btnArchive"
            android:layout_marginEnd="8dp"/>

        <!-- Info -->
        <TextView
            android:id="@+id/tvPatientInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Male • 35 years • MRN 12"
            android:textColor="#777777"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tvPatientName"
            app:layout_constraintStart_toEndOf="@id/imgPatient"
            app:layout_constraintEnd_toStartOf="@id/btnArchive"
            android:layout_marginEnd="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
