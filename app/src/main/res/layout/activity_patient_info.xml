<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Main card (nicer spacing) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="7dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Back -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_back_circle"
                    android:src="@drawable/ic_back"
                    app:tint="#3D008F"
                    android:contentDescription="@null"
                    tools:ignore="MissingConstraints" />

                <!-- Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="114dp"
                    android:layout_height="114dp"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="57dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3D008F"
                    app:strokeWidth="6dp"
                    app:layout_constraintTop_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_male"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Name -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Patient Name"
                    android:textColor="#3D008F"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/cardAvatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Info button -->
                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="234dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#00BFA6"
                    android:text="Consultation History"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvName"
                    app:strokeColor="#3D008F"
                    app:strokeWidth="2dp" />

                <!-- Inner rounded container for the table -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E8E8E8"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/btnInfo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/layoutTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Row helper: each row marginBottom + subtle divider -->
                        <!-- MRN -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Medical Record Number"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvMrn"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Name -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Name"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvNameRow"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Age -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Age"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvAge"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Gender -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Gender"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvGender"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Record Creation Date -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Record Creation Date"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvCreatedDate"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Last Update -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Last Update"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvLastUpdate"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <!-- Multi-line fields -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Current Medications"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvMeds"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:minLines="2"
                                android:lineSpacingExtra="2dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Previous Surgeries"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvSurgeries"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:minLines="2"
                                android:lineSpacingExtra="2dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Drug Allergies"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvAllergies"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:minLines="2"
                                android:lineSpacingExtra="2dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1.2"
                                android:padding="12dp"
                                android:text="Family History of Genetic Diseases"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:background="#3D008F"/>

                            <TextView
                                android:id="@+id/tvFamily"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="12dp"
                                android:minLines="2"
                                android:lineSpacingExtra="2dp"
                                android:text="—"
                                android:textColor="#3D008F"
                                android:textSize="13sp"
                                android:background="#EFEFEF"/>
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
