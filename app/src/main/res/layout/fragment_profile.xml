<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D008F"
    android:padding="16dp"
    tools:context=".ui.fragments.ProfileFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="7dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Doctor Profile"
                    android:textColor="#3D008F"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Avatar circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3D008F"
                    app:strokeWidth="6dp"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_doctor"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:padding="14dp"
                        android:contentDescription="@null"/>

                </com.google.android.material.card.MaterialCardView>

                <!-- Name -->
                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="—"
                    android:textColor="#3D008F"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/cardAvatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Email -->
                <TextView
                    android:id="@+id/tvDoctorEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="—"
                    android:textColor="#6A5A89"
                    android:textSize="14sp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/tvDoctorName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Info box -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EDE7FF"
                    app:cardBackgroundColor="#FAF8FF"
                    app:layout_constraintTop_toBottomOf="@id/tvDoctorEmail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account"
                            android:textColor="#3D008F"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <!-- UID row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UID:"
                                android:textColor="#3D008F"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDoctorUid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="—"
                                android:textColor="#6A5A89"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <ImageView
                                android:id="@+id/btnCopyUid"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_copy"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="#3D008F"/>
                        </LinearLayout>
                        <!-- Phone row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phone:"
                                android:textColor="#3D008F"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvDoctorPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="—"
                                android:textColor="#6A5A89"/>
                        </LinearLayout>


                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EDE7FF"
                    app:cardBackgroundColor="#FAF8FF"
                    app:layout_constraintTop_toBottomOf="@id/cardInfo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvStatsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Statistics"
                            android:textColor="#3D008F"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <!-- Patients box -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/boxPatients"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:strokeColor="#EDE7FF"
                            app:strokeWidth="1dp"
                            app:layout_constraintTop_toBottomOf="@id/tvStatsTitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/boxConsults"
                            app:layout_constraintHorizontal_chainStyle="spread"
                            app:layout_constraintWidth_percent="0.49">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Patients"
                                    android:textColor="#6A5A89"
                                    android:textSize="13sp"/>

                                <TextView
                                    android:id="@+id/tvPatientsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#3D008F"
                                    android:textStyle="bold"
                                    android:textSize="24sp"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Consultations box -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/boxConsults"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/white"
                            app:strokeColor="#EDE7FF"
                            app:strokeWidth="1dp"
                            app:layout_constraintTop_toBottomOf="@id/tvStatsTitle"
                            app:layout_constraintStart_toEndOf="@id/boxPatients"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintWidth_percent="0.49">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Consultations"
                                    android:textColor="#6A5A89"
                                    android:textSize="13sp"/>

                                <TextView
                                    android:id="@+id/tvConsultationsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="#3D008F"
                                    android:textStyle="bold"
                                    android:textSize="24sp"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Loading hint -->
                        <TextView
                            android:id="@+id/tvStatsHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Updating…"
                            android:textColor="#6A5A89"
                            android:textSize="12sp"
                            android:gravity="center"
                            app:layout_constraintTop_toBottomOf="@id/boxPatients"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipArchivedPatients"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Archived Patients"
                            android:textColor="#3D008F"
                            android:textStyle="bold"
                            app:chipBackgroundColor="@android:color/white"
                            app:chipCornerRadius="16dp"
                            app:chipStrokeColor="#EDE7FF"
                            app:chipStrokeWidth="1.5dp"
                            app:chipIcon="@drawable/ic_archive"
                            app:chipIconTint="#3D008F"
                            app:chipIconVisible="true"
                            android:clickable="true"
                            android:focusable="true"
                            app:layout_constraintTop_toBottomOf="@id/tvStatsHint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- Logout button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#BF0000"
                    app:cornerRadius="16dp"
                    app:strokeColor="#3D008F"
                    app:strokeWidth="2dp"
                    app:layout_constraintTop_toBottomOf="@id/cardStats"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Small hint -->
                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="You can login again anytime."
                    android:textColor="#6A5A89"
                    android:textSize="13sp"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/btnLogout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
