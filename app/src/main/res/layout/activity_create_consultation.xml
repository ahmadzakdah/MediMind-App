<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main content ===== -->
    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Create Consultation"
                        android:textColor="#4B0099"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- زر يفتح/يسكر الفايتلز -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVitals"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#4B0099"
                        android:text="Vitals"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="14dp" />

                    <!-- Patient (read-only): Age + Gender -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Patient"
                        android:textColor="#4B0099"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPatientMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#EDEAF5"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Age"
                                    android:textColor="#6B6B6B"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPatientAgeValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="—"
                                    android:textColor="#2A2A2A"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:background="#EEEAF5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Gender"
                                    android:textColor="#6B6B6B"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPatientGenderValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="—"
                                    android:textColor="#2A2A2A"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- باقي الشاشة: symptoms + notes + save ... -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Symptoms"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSymptom"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="#EDEAF5"
                        app:boxBackgroundColor="#FFFFFF"

                        app:startIconDrawable="@drawable/ic_search"
                        app:startIconTint="#4B0099"
                        app:startIconContentDescription="Search"
                        app:endIconMode="clear_text">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/etSymptom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Type a symptom (e.g., fever)"
                            android:inputType="text"
                            android:popupBackground="@drawable/bg_dropdown_popup"
                            android:dropDownVerticalOffset="10dp"
                            android:dropDownHeight="280dp"/>
                    </com.google.android.material.textfield.TextInputLayout>



                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSymptomResults"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsSymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="10dp"
                        app:chipSpacingVertical="10dp"
                        app:singleLine="false"/>


                    <!-- Predict hint (text فوق النتائج) -->
                    <TextView
                        android:id="@+id/tvPredictHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Choose at least 2 symptoms to start prediction."
                        android:textColor="#6B6B6B"
                        android:textSize="13sp" />

                    <!-- Container لعرض النتائج (Top3) -->
                    <LinearLayout
                        android:id="@+id/predictBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="#F7F4FF"
                        android:padding="12dp"/>
                    
                    <TextView
                        android:id="@+id/tvSuggestTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suggested symptoms"
                        android:textStyle="bold"
                        android:textColor="#4B0099"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="10dp"
                        app:chipSpacingVertical="10dp"
                        app:singleLine="false"
                        android:visibility="gone"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <Button
                            android:id="@+id/btnCancel"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Cancel"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#E53935"
                            android:elevation="4dp" />
                        <View
                            android:layout_width="12dp"
                            android:layout_height="1dp"/>
                    <Button
                        android:id="@+id/btnContinue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#00BFA6"
                        android:text="Continue"
                        android:textSize="15dp"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay (click to close) -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:alpha="0"
        android:visibility="gone" />


    <!-- ===== Bottom Sheet (Vitals Panel) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/vitalsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeColor="#EEEAF5"
        app:strokeWidth="1dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_fitToContents="true"
        app:behavior_peekHeight="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- handle صغير -->
            <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="#E6E1F2"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitals (optional)"
                android:textColor="#4B0099"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- Vitals grid -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vitalsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <!-- SYS -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSys"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardDia"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.49">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Systolic"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etSysBP"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mmHg"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeSys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 70–200"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- DIA -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toEndOf="@id/cardSys"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.49"
                    android:layout_marginStart="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diastolic"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etDiaBP"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mmHg"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeDia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 40–130"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- HR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardRr"
                    app:layout_constraintTop_toBottomOf="@id/cardSys"
                    app:layout_constraintWidth_percent="0.49">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heart Rate"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etHR"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="bpm"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeHr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 40–180"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RR -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toEndOf="@id/cardHr"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardDia"
                    app:layout_constraintWidth_percent="0.49">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Respiratory Rate"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etRR"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="/min"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeRr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 8–40"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sugar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSugar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardTemp"
                    app:layout_constraintTop_toBottomOf="@id/cardHr"
                    app:layout_constraintWidth_percent="0.49">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blood Sugar"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etBloodSugar"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="mg/dL"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeSugar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 50–400"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Temp -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTemp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toEndOf="@id/cardSugar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardRr"
                    app:layout_constraintWidth_percent="0.49">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temperature"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etTemp"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="numberDecimal"
                                android:maxLength="4"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="°C"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 35.0–42.0"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SpO2 (full width nice) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSpo2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EDEAF5"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardSugar">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SpO₂"
                            android:textColor="#6B6B6B"
                            android:textSize="12sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <EditText
                                android:id="@+id/etSpO2"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="—"
                                android:inputType="number"
                                android:maxLength="3"
                                android:padding="0dp"
                                android:textColor="#2A2A2A"
                                android:textSize="16sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="%"
                                android:textColor="#4B0099"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#EEEAF5"/>
                        <TextView
                            android:id="@+id/tvRangeSpo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Allowed: 70–100"
                            android:textSize="11sp"
                            android:textColor="#8A8A8A"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- زر submit صغير -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitVitals"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="Submit Vitals"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00BFA6"
                app:cornerRadius="14dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
